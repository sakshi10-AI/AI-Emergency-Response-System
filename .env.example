# =============================================================================
# Production Environment Variables & Secrets Configuration
# =============================================================================

# Project Metadata
PROJECT_NAME="AI Emergency Response System"
VERSION="1.0.0"
DEBUG=false

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ai_emergency_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@database:5432/ai_emergency_db

# Redis Memory & State Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Authentication & Security Secrets
SECRET_KEY=eoc-super-secret-jwt-signing-key-change-in-prod-2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM & AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Service Endpoint URLs
BACKEND_API_URL=http://backend:8000
WS_API_URL=ws://backend:8000/api/v1/ws
